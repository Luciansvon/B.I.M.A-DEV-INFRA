{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A artifact manifest v1",
  "type": "object",
  "required": ["schema", "manifest_id", "project", "subject", "policy", "request_sha256", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-artifact-manifest.v1"},
    "manifest_id": {"$ref": "#/$defs/identifier"},
    "project": {"$ref": "#/$defs/project"},
    "subject": {"$ref": "#/$defs/subject"},
    "policy": {"$ref": "#/$defs/policy"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "project": {"type": "object", "required": ["id", "repository"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/identifier"}, "repository": {"type": "string", "minLength": 1, "maxLength": 256}}},
    "subject": {"type": "object", "required": ["revision", "dirty"], "additionalProperties": false, "properties": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"type": "boolean"}}},
    "policy": {"type": "object", "required": ["revision", "sha256"], "additionalProperties": false, "properties": {"revision": {"type": "string", "minLength": 1, "maxLength": 256}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "retention": {"type": "object", "required": ["owner", "location", "minimum_days"], "additionalProperties": false, "properties": {"owner": {"type": "string", "minLength": 1, "maxLength": 256}, "location": {"type": "string", "minLength": 1, "maxLength": 512}, "minimum_days": {"type": "integer", "minimum": 0, "maximum": 36500}}},
    "artifact": {"type": "object", "required": ["artifact_id", "path", "media_type", "role", "sensitivity", "maximum_bytes", "retention", "size_bytes", "sha256"], "additionalProperties": false, "properties": {"artifact_id": {"$ref": "#/$defs/identifier"}, "path": {"type": "string", "minLength": 1, "maxLength": 512}, "media_type": {"type": "string", "minLength": 3, "maxLength": 255}, "role": {"enum": ["primary", "checksum", "sbom", "signature", "attestation", "report", "auxiliary"]}, "sensitivity": {"enum": ["public", "internal", "restricted"]}, "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776}, "retention": {"$ref": "#/$defs/retention"}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1099511627776}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
