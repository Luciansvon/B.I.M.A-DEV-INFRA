{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A artifact verification v1",
  "type": "object",
  "required": ["schema", "verdict", "reason_code", "identity", "policy", "manifest_sha256", "counts", "checks", "unresolved_artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-artifact-verification.v1"},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "reason_code": {"enum": ["ALL_ARTIFACTS_MATCH", "ARTIFACT_PATH_UNSAFE", "ARTIFACT_MISSING", "ARTIFACT_CHANGED"]},
    "identity": {"type": "object", "required": ["manifest_id", "project_id", "repository", "subject_revision", "subject_dirty"], "additionalProperties": false, "properties": {"manifest_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1}, "subject_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "subject_dirty": {"type": "boolean"}}},
    "policy": {"type": "object", "required": ["revision", "sha256"], "additionalProperties": false, "properties": {"revision": {"type": "string", "minLength": 1, "maxLength": 256}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {"type": "object", "required": ["declared", "matched", "missing", "changed", "unsafe"], "additionalProperties": false, "properties": {"declared": {"type": "integer", "minimum": 1}, "matched": {"type": "integer", "minimum": 0}, "missing": {"type": "integer", "minimum": 0}, "changed": {"type": "integer", "minimum": 0}, "unsafe": {"type": "integer", "minimum": 0}}},
    "checks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["artifact_id", "path", "status", "expected_size_bytes", "observed_size_bytes", "expected_sha256", "observed_sha256"], "additionalProperties": false, "properties": {"artifact_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "status": {"enum": ["MATCH", "MISSING", "CHANGED", "UNSAFE"]}, "expected_size_bytes": {"type": "integer", "minimum": 0}, "observed_size_bytes": {"type": ["integer", "null"], "minimum": 0}, "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "observed_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}}},
    "unresolved_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
