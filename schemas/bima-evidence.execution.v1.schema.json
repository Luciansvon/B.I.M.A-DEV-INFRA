{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A evidence execution metadata v1",
  "type": "object",
  "required": ["schema", "canonical", "source", "runtime"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-evidence.execution.v1"},
    "canonical": {
      "type": "object",
      "required": ["name", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "canonical.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "sha256", "generated_at"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_at": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["system", "machine", "python_version"],
      "additionalProperties": false,
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
