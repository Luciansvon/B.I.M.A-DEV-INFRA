{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A canonical evidence v1",
  "type": "object",
  "required": ["schema", "status", "subject", "policy", "toolchain", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-evidence.v1"},
    "status": {"enum": ["pass", "fail", "error"]},
    "subject": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "policy": {
      "type": "object",
      "required": ["sha256"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "oneOf": [
          {"required": ["version"]},
          {"required": ["sha256"]}
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "metrics", "findings"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "error"]},
          "metrics": {
            "type": "object",
            "required": ["files_checked", "local_links_checked", "findings_count"],
            "additionalProperties": false,
            "properties": {
              "files_checked": {"type": "integer", "minimum": 0},
              "local_links_checked": {"type": "integer", "minimum": 0},
              "findings_count": {"type": "integer", "minimum": 0}
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "path", "line", "message"],
              "additionalProperties": false,
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "line": {"type": ["integer", "null"], "minimum": 1},
                "message": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
