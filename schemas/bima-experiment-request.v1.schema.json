{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A gated experiment request v1",
  "type": "object",
  "required": [
    "schema", "experiment_id", "capability", "baseline", "dataset",
    "acceptance_thresholds", "budget", "permissions", "reject_criteria",
    "rollback", "demand_evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-experiment-request.v1"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "capability": {
      "enum": [
        "graphify-context", "release-proof", "local-qa-slm", "sandbox",
        "database-verifier", "durable-workflow", "security-response",
        "fleet-telemetry"
      ]
    },
    "baseline": {
      "type": "object",
      "required": ["id", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "dataset": {
      "type": "object",
      "required": ["id", "sha256", "verified_cases", "held_out"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified_cases": {"type": "integer", "minimum": 0},
        "held_out": {"type": "boolean"}
      }
    },
    "acceptance_thresholds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["metric", "operator", "value", "unit"],
        "additionalProperties": false,
        "properties": {
          "metric": {"type": "string"},
          "operator": {"enum": ["lt", "lte", "eq", "gte", "gt"]},
          "value": {"type": "integer"},
          "unit": {"type": "string"}
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_runtime_seconds", "max_storage_bytes", "max_network_calls", "max_agent_calls"],
      "additionalProperties": false,
      "properties": {
        "max_runtime_seconds": {"type": "integer", "minimum": 1},
        "max_storage_bytes": {"type": "integer", "minimum": 0},
        "max_network_calls": {"type": "integer", "minimum": 0},
        "max_agent_calls": {"type": "integer", "minimum": 0}
      }
    },
    "permissions": {
      "type": "object",
      "required": ["write_roots", "network_destinations", "credential_names"],
      "additionalProperties": false,
      "properties": {
        "write_roots": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
        "network_destinations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
        "credential_names": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "reject_criteria": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}},
    "rollback": {
      "type": "object",
      "required": ["owner", "steps"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": "string"},
        "steps": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}}
      }
    },
    "demand_evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["project_id", "repository", "requirement_ref", "reviewed_by"],
        "additionalProperties": false,
        "properties": {
          "project_id": {"type": "string"},
          "repository": {"type": "string"},
          "requirement_ref": {"type": "string"},
          "reviewed_by": {"type": "string"}
        }
      }
    }
  }
}
