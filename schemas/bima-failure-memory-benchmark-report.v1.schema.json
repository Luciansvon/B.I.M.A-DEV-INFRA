{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A failure-memory benchmark report v1",
  "type": "object",
  "required": ["schema", "benchmark_id", "dataset_id", "record_set_sha256", "request_sha256", "status", "reason_code", "real_verified_records", "query_count", "k", "metrics", "database_created"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-failure-memory-benchmark-report.v1"},
    "benchmark_id": {"type": "string"},
    "dataset_id": {"type": "string"},
    "record_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "reason_code": {"type": "string"},
    "real_verified_records": {"type": "integer", "minimum": 0},
    "query_count": {"type": "integer", "minimum": 0},
    "k": {"type": "integer", "minimum": 1, "maximum": 50},
    "metrics": {
      "type": ["object", "null"],
      "required": ["recall_at_k_ppm", "mrr_ppm", "false_match_ppm", "stale_hit_ppm"],
      "additionalProperties": false,
      "properties": {
        "recall_at_k_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "mrr_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "false_match_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "stale_hit_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "database_created": {"type": "boolean"},
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "returned_record_ids", "first_relevant_rank"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "returned_record_ids": {"type": "array", "items": {"type": "string"}},
          "first_relevant_rank": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
