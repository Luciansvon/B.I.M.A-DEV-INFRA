{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A failure-memory benchmark request v1",
  "type": "object",
  "required": ["schema", "benchmark_id", "dataset_id", "record_set_sha256", "held_out", "acceptance", "queries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-failure-memory-benchmark-request.v1"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "record_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "held_out": {"type": "boolean"},
    "acceptance": {
      "type": "object",
      "required": ["k", "minimum_recall_ppm", "minimum_mrr_ppm", "maximum_false_match_ppm", "maximum_stale_hit_ppm"],
      "additionalProperties": false,
      "properties": {
        "k": {"type": "integer", "minimum": 1, "maximum": 50},
        "minimum_recall_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "minimum_mrr_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "maximum_false_match_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "maximum_stale_hit_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "queries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "text", "project_id", "relevant_record_ids", "forbidden_record_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 512},
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "relevant_record_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
          "forbidden_record_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
