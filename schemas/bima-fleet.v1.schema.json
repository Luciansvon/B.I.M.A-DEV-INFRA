{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A repository fleet v1",
  "type": "object",
  "required": ["schema", "schema_version", "repositories"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-fleet.v1"},
    "schema_version": {"const": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["repository", "workflow"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"}
      }
    }
  }
}
