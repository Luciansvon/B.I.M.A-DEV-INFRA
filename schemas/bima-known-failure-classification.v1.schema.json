{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A known failure classification v1",
  "type": "object",
  "required": ["schema", "classification", "route", "automatic_retry_allowed", "result", "registry", "match"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-known-failure-classification.v1"},
    "classification": {"enum": ["not_applicable", "unmatched", "inactive_match", "expired_match", "known_failure"]},
    "route": {"enum": ["none", "machine", "agent"]},
    "automatic_retry_allowed": {"const": false},
    "result": {
      "type": "object",
      "required": ["sha256", "verdict", "equivalence_key"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN", "BLOCKED"]},
        "equivalence_key": {"type": "string", "minLength": 1}
      }
    },
    "registry": {
      "type": "object",
      "required": ["sha256", "as_of"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    },
    "match": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["entry_id", "owner", "reviewed_by", "created_at", "expires_at", "issue_ref"],
          "additionalProperties": false,
          "properties": {
            "entry_id": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "reviewed_by": {"type": "string", "minLength": 1},
            "created_at": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "minLength": 1},
            "issue_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
