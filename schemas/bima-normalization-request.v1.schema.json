{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A normalization request v1",
  "type": "object",
  "required": ["schema", "project", "subject", "check", "adapter", "command", "policy", "environment", "attempt", "exit_code", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-normalization-request.v1"},
    "project": {
      "type": "object",
      "required": ["id", "repository"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "repository": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "subject": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "check": {
      "type": "object",
      "required": ["id", "required", "expected_tests"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "required": {"type": "boolean"},
        "expected_tests": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "adapter": {"const": "rust-libtest-text.v1"},
    "command": {"$ref": "#/$defs/identity"},
    "policy": {
      "type": "object",
      "required": ["revision", "sha256"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "toolchain"],
      "additionalProperties": false,
      "properties": {
        "os": {"type": "string", "minLength": 1, "maxLength": 256},
        "arch": {"type": "string", "minLength": 1, "maxLength": 256},
        "toolchain": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "attempt": {
      "type": "object",
      "required": ["id", "sequence", "equivalence_key"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 100},
        "equivalence_key": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "sources": {
      "type": "object",
      "required": ["native_output_sha256", "failure_log_sha256"],
      "additionalProperties": false,
      "properties": {
        "native_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "failure_log_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["id", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
