{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A trusted policy v1",
  "type": "object",
  "required": ["schema", "policy_id", "revision", "projects", "operations", "budget"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-policy.v1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["project_id", "repository"],
        "additionalProperties": false,
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "repository": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "command_ref", "max_timeout_seconds", "output_roots", "network_destinations", "credential_names", "max_attempts"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "command_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "max_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "output_roots": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "network_destinations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "credential_names": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 16}
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_calls", "max_runtime_seconds"],
      "additionalProperties": false,
      "properties": {
        "max_calls": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}
