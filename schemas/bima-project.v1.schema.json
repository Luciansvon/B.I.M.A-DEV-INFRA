{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A project contract v1",
  "type": "object",
  "required": ["schema", "project_id", "repository", "operations"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-project.v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "repository": {"type": "string", "minLength": 1, "maxLength": 256},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "command_ref", "required", "timeout_seconds", "output_root", "audit_policy"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "command_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "required": {"type": "boolean"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "output_root": {"type": "string", "minLength": 1, "maxLength": 256},
          "audit_policy": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
