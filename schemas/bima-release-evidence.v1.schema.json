{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A release evidence v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "tag",
    "title",
    "target_sha",
    "prerelease",
    "dry_run",
    "published",
    "release_url",
    "run_url",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-release-evidence.v1"},
    "schema_version": {"const": 1},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$"},
    "title": {"type": "string"},
    "target_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "prerelease": {"type": "boolean"},
    "dry_run": {"type": "boolean"},
    "published": {"type": "boolean"},
    "release_url": {"type": ["string", "null"]},
    "run_url": {"type": "string"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["name", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
