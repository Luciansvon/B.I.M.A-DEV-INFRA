{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A verification plan v1",
  "type": "object",
  "required": ["schema", "aggregate_id", "project", "subject", "policy", "required_checks", "optional_checks"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-verification-plan.v1"},
    "aggregate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "project": {
      "type": "object",
      "required": ["id", "repository"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "repository": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "subject": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "policy": {
      "type": "object",
      "required": ["revision", "sha256"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
    },
    "optional_checks": {"$ref": "#/$defs/checks"}
  },
  "$defs": {
    "checks": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}
    }
  }
}
