{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B.I.M.A verification result v2",
  "type": "object",
  "required": ["schema", "verdict", "identity", "adapter", "command", "policy", "environment", "attempt", "execution", "applicability", "outcome", "stability", "sources", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "bima-verification-result.v2"},
    "verdict": {"enum": ["PASS", "FAIL", "UNKNOWN", "BLOCKED"]},
    "identity": {
      "type": "object",
      "required": ["project_id", "repository", "subject_revision", "subject_dirty", "check_id"],
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "subject_dirty": {"type": "boolean"},
        "check_id": {"type": "string", "minLength": 1}
      }
    },
    "adapter": {"const": "rust-libtest-text.v1"},
    "command": {"$ref": "#/$defs/identityHash"},
    "policy": {
      "type": "object",
      "required": ["revision", "sha256"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "toolchain"],
      "additionalProperties": false,
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "toolchain": {"type": "string", "minLength": 1}
      }
    },
    "attempt": {
      "type": "object",
      "required": ["id", "sequence", "equivalence_key"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "equivalence_key": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "required": ["lifecycle", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": {"const": "completed"},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "applicability": {"enum": ["required", "optional"]},
    "outcome": {
      "type": "object",
      "required": ["value", "reason_code", "expected_tests", "observed_tests", "counts", "suites"],
      "additionalProperties": false,
      "properties": {
        "value": {"enum": ["pass", "fail", "unknown", "not_run"]},
        "reason_code": {"type": "string", "minLength": 1},
        "expected_tests": {"type": "integer", "minimum": 1},
        "observed_tests": {"type": "integer", "minimum": 0},
        "counts": {"$ref": "#/$defs/counts"},
        "suites": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/suite"}
        }
      }
    },
    "stability": {
      "type": "object",
      "required": ["value", "equivalence_key"],
      "additionalProperties": false,
      "properties": {
        "value": {"enum": ["unassessed", "consistent_observed", "flaky"]},
        "equivalence_key": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "sha256", "size_bytes"],
        "additionalProperties": false,
        "properties": {
          "role": {"enum": ["native-test-output", "failure-log"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["tool", "code", "path", "line", "column", "message"],
        "additionalProperties": false,
        "properties": {
          "tool": {"const": "typescript"},
          "code": {"type": "string", "pattern": "^TS[0-9]+$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "line": {"type": "integer", "minimum": 1},
          "column": {"type": "integer", "minimum": 1},
          "message": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    }
  },
  "$defs": {
    "identityHash": {
      "type": "object",
      "required": ["id", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["passed", "failed", "ignored", "measured", "filtered_out"],
      "additionalProperties": false,
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0},
        "measured": {"type": "integer", "minimum": 0},
        "filtered_out": {"type": "integer", "minimum": 0}
      }
    },
    "suite": {
      "type": "object",
      "required": ["status", "passed", "failed", "ignored", "measured", "filtered_out"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["ok", "failed"]},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "ignored": {"type": "integer", "minimum": 0},
        "measured": {"type": "integer", "minimum": 0},
        "filtered_out": {"type": "integer", "minimum": 0}
      }
    }
  }
}
